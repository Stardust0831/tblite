include(FindPackageHandleStandardArgs)
find_path(CUSOLVERMP_INCLUDE_DIR cusolverMp.h HINTS ${cuSOLVERMp_ROOT} PATH_SUFFIXES include)
find_library(CUSOLVERMP_LIBRARY cusolverMp HINTS ${cuSOLVERMp_ROOT} PATH_SUFFIXES lib lib64)
find_path(NCCL_INCLUDE_DIR nccl.h HINTS ENV NCCL_ROOT PATH_SUFFIXES include)
find_library(NCCL_LIBRARY nccl HINTS ENV NCCL_ROOT PATH_SUFFIXES lib lib64)
find_package_handle_standard_args(cuSOLVERMp REQUIRED_VARS
  CUSOLVERMP_INCLUDE_DIR CUSOLVERMP_LIBRARY NCCL_INCLUDE_DIR NCCL_LIBRARY)
if(cuSOLVERMp_FOUND AND NOT TARGET cuSOLVERMp::cuSOLVERMp)
  add_library(cuSOLVERMp::cuSOLVERMp INTERFACE IMPORTED)
  set_target_properties(cuSOLVERMp::cuSOLVERMp PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${CUSOLVERMP_INCLUDE_DIR};${NCCL_INCLUDE_DIR}"
    INTERFACE_LINK_LIBRARIES "${CUSOLVERMP_LIBRARY};${NCCL_LIBRARY}")
endif()
